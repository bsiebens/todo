{
  "name": "todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && APP_URL=http://localhost:5173 STATIC_DIR=dist node dist-server/server.cjs",
    "build": "tsc -b && tsc -p server && vite build && npm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=dist-server/server.cjs --log-level=warning",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p server"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrule": "^2.8.1",
    "web-push": "^4.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
