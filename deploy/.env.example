# Copy to .env next to docker-compose.yml and fill in.

# The address you open the app at, exactly as typed in the browser (https, no trailing slash).
# Passkeys are tied to this host name, so pick it once.
APP_URL=https://todo.example.com

# Password for the bundled Postgres database. Any long random string.
POSTGRES_PASSWORD=change-me-to-something-long

# Port on the home server that your reverse proxy forwards to.
PORT=8080

# Optional: your own setup code for the first device. If empty, one is generated
# and printed in the log (docker compose logs app).
SETUP_CODE=

# Optional: sign-in codes by email. Both are needed to turn it on.
# OWNER_EMAIL is the only address that can receive a code.
OWNER_EMAIL=
# For example smtps://user:password@smtp.example.com:465
SMTP_URL=
# Sender address, defaults to OWNER_EMAIL.
MAIL_FROM=
